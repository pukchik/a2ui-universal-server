HOST=127.0.0.1
PORT=3100
PUBLIC_URL=http://localhost:3100
DATABASE_URL=postgres://a2ui:a2ui@127.0.0.1:5432/a2ui
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:18080/realms/a2ui
OIDC_CLIENT_ID=a2ui
OIDC_CLIENT_SECRET=local-development-secret
ADAPTER=codex
CODEX_BIN=codex
# Separate operator-managed CLI profile, authenticated before startup:
CODEX_PROFILE_DIR=/absolute/path/to/service-codex-profile
# CODEX_MODEL=
# CODEX_RUNTIME_DIR=/absolute/path/to/writable-codex-runtime
RUN_TIMEOUT_MS=120000
MAX_CONCURRENT_RUNS=2
# Local deterministic demonstration only; never enable on a public listener:
# AUTH_MODE=demo
# ADAPTER=fixture
# Operator-registered catalog source and project instructions (optional):
# CATALOG_SOURCE_CONFIG=/absolute/path/to/catalog-source.json
# PROJECT_INSTRUCTIONS_FILE=/absolute/path/to/project-instructions.txt
